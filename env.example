# ============================================
# Database Configuration
# ============================================
# Docker Compose PostgreSQL connection
DATABASE_URL="postgresql://lgurd_user:lgurd_password@localhost:5432/lgurd_db?schema=public"

# ============================================
# Stripe Configuration
# ============================================
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY_HERE"

# For local development, get from Stripe CLI:
# Run: stripe listen --forward-to localhost:3000/api/webhook/stripe
# Copy the whsec_... value shown
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# ============================================
# Resend Email Configuration
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_RESEND_API_KEY_HERE"
# IMPORTANT: When using "onboarding@resend.dev", you can ONLY send emails to YOUR verified email address
# To send emails to customers, you MUST:
# 1. Verify your domain at https://resend.com/domains
# 2. Set RESEND_FROM_EMAIL to an email using your verified domain (e.g., "orders@yourdomain.com")
# For testing with "onboarding@resend.dev", emails can only go to your own verified email
RESEND_FROM_EMAIL="onboarding@resend.dev"
# Optional: Admin email to receive order notifications (must be your verified email if using onboarding@resend.dev)
RESEND_ADMIN_EMAIL=""

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
